#!/bin/bash
# extract-audio - 从视频文件提取音频并转换为 MP3
# 用法: extract-audio <视频文件路径> [输出目录]
# 示例: extract-audio "/path/to/video.mp4"
#       extract-audio "/path/to/video.mp4" "/path/to/output"

set -e

# 检查参数
if [ -z "$1" ]; then
    echo "用法: extract-audio <视频文件路径> [输出目录]"
    echo "示例: extract-audio \"/path/to/video.mp4\""
    exit 1
fi

INPUT_FILE="$1"
OUTPUT_DIR="${2:-$(dirname "$1")}"

# 检查 ffmpeg 是否安装
if ! command -v ffmpeg &> /dev/null; then
    echo "错误: ffmpeg 未安装。请运行: brew install ffmpeg"
    exit 1
fi

# 检查输入文件是否存在
if [ ! -f "$INPUT_FILE" ]; then
    echo "错误: 文件不存在: $INPUT_FILE"
    exit 1
fi

# 获取文件名（不含扩展名）和扩展名
FILENAME=$(basename "$INPUT_FILE")
BASENAME="${FILENAME%.*}"
OUTPUT_FILE="${OUTPUT_DIR}/${BASENAME}.mp3"

# 执行转换
echo "正在提取音频: $FILENAME"
echo "输出文件: $OUTPUT_FILE"

ffmpeg -i "$INPUT_FILE" -vn -ar 44100 -ac 2 -ab 192k "$OUTPUT_FILE" -y

# 获取文件大小
SIZE=$(du -h "$OUTPUT_FILE" | cut -f1)

echo "完成! 文件大小: $SIZE"
echo "保存位置: $OUTPUT_FILE"
